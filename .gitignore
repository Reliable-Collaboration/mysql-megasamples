# Downloaded upstream artifacts and everything a build produces (ARCHITECTURE.md section 2)
downloads/
build/
*.bak
*.7z
*.parquet
*.zst
*.tsv
.venv/
work/
__pycache__/

# local choices, and what is generated from them: `make configure` writes megasamples.yaml,
# `make compose` writes compose.yaml, `make up` writes the landing page. .env.example is the
# committed template for the credentials.
.env
megasamples.yaml
compose.yaml
consoles/landing/index.html

# staged release assets: the files are large and are mirrors of upstream artifacts, but the
# manifest and checksums that describe them are the record and are committed
release/*/*
!release/*/SHA256SUMS
!release/*/MANIFEST.md
