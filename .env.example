# Copy to `.env` to change the accounts the image and the consoles use:
#
#   cp .env.example .env      # then edit, then: make up   (or docker compose up -d)
#
# Nothing here is a secret. These are the boilerplate credentials of a disposable test database, and
# they are committed on purpose so that `docker compose up` works with no setup at all. The point of
# the file is that you can change them in one place if you want to: compose passes each value both to
# the server (which applies it with ALTER USER at startup) and to every console, so the two never
# drift apart.
#
# Two accounts exist, and both are usable from every console:
#   demo   SELECT and SHOW VIEW only -- cannot write anything, anywhere
#   admin  ALL PRIVILEGES WITH GRANT OPTION
#
# The user names are baked into the image and are not configurable; only the passwords are.

DEMO_PASSWORD=demo
ADMIN_PASSWORD=admin

# root@localhost and root@'%'. Left commented so the image keeps its baked default of `root`.
# MYSQL_ROOT_PASSWORD=root

# The image to run. Change it to test a published tag instead of the locally built one.
# MEGASAMPLES_MYSQL_IMAGE=sql-megasamples-mysql:dev
