# syntax=docker/dockerfile:1.7
# P-03 throwaway: prove that a data directory baked in a builder stage survives into the final
# image and that the official entrypoint starts it without re-initializing.
ARG MYSQL_VERSION=9.7.2

FROM mysql:${MYSQL_VERSION} AS builder
COPY docker/my.cnf /etc/mysql/conf.d/megasamples.cnf
COPY docker/init/00-users.sql /build/init/00-users.sql
COPY docker/context/sakila/ /build/sakila/
RUN <<'SH'
set -eux
S=/var/run/mysqld/mysqld.sock
mysqld --initialize-insecure --user=mysql
mysqld --user=mysql --daemonize --skip-networking --socket=$S --pid-file=/var/run/mysqld/mysqld.pid
for i in $(seq 1 60); do mysql -S $S -uroot -e 'SELECT 1' >/dev/null 2>&1 && break; sleep 1; done
mysql -S $S -uroot -e "ALTER INSTANCE DISABLE INNODB REDO_LOG"
# the base image is oraclelinux:9-slim with microdnf only: no unzip, no python3.
# every artifact reaches the builder already extracted by the host pipeline.
mysql -S $S -uroot < /build/sakila/sakila-schema.sql
mysql -S $S -uroot < /build/sakila/sakila-data.sql
mysql_tzinfo_to_sql /usr/share/zoneinfo 2>/dev/null | mysql -S $S -uroot mysql
mysql -S $S -uroot -e "ALTER INSTANCE ENABLE INNODB REDO_LOG"
# accounts LAST: 00-users.sql gives root@localhost a password, so every command after it
# must authenticate. Running it earlier breaks the rest of the stage (found at P-03).
mysql -S $S -uroot < /build/init/00-users.sql
mysqladmin -S $S -uroot -proot shutdown
rm -rf /build
SH

FROM mysql:${MYSQL_VERSION}
COPY docker/my.cnf /etc/mysql/conf.d/megasamples.cnf
COPY --from=builder --chown=mysql:mysql /var/lib/mysql /var/lib/mysql
