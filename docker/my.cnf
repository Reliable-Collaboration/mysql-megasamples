# megasamples server configuration (mounted at /etc/mysql/conf.d/megasamples.cnf)
[mysqld]
character-set-server         = utf8mb4
collation-server             = utf8mb4_0900_ai_ci
# information_schema size columns must be live for the size tests (PLAN.md section 4)
information_schema_stats_expiry = 0
# the sample data is read-mostly; a modest pool keeps the image usable on small machines
innodb_buffer_pool_size      = 512M

[client]
default-character-set        = utf8mb4
